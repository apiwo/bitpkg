DEPS="make"
SRC_URL="https://github.com/vim/vim/archive/refs/tags/v9.1.0.tar.gz"
BUILD_CMD="CC=$CC ./configure --prefix=PREFIX --enable-multibyte --enable-terminal --with-features=huge && make -jNPROC"
INSTALL_CMD="make install"
REMOVE_CMD="make uninstall"
VERSION="9.1.0"
DESC="Vim is a highly configurable text editor built to enable efficient text editing."
