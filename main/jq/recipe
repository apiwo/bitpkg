DEPS="autoconf automake libtool make gcc"
SRC_URL="https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-1.7.1.tar.gz"
VERSION="1.7.1"
DESC="Lightweight and flexible command-line JSON processor"
BUILD_CMD="./configure --prefix=${PREFIX:-/usr/local} --with-oniguruma=builtin CFLAGS='-Wno-error' && make -j$NPROC"
INSTALL_CMD="make prefix=${PREFIX:-/usr/local} install"
REMOVE_CMD="rm -f ${PREFIX:-/usr/local}/bin/jq"
