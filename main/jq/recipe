DEPS="autoconf automake libtool make gcc git"
SRC_URL="https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-1.7.1.tar.gz"
VERSION="1.7.1"
DESC="Lightweight and flexible command-line JSON processor"
BUILD_CMD="git submodule update --init --recursive || true; if [ ! -f configure ]; then autoreconf -ivf; fi; ./configure --prefix=PREFIX --with-oniguruma=builtin && make -jNPROC"
INSTALL_CMD="make install"
REMOVE_CMD="rm -f $PREFIX/bin/jq"
